<UserControl x:Class="psdPH.Nodes.UI.SetupBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:psdPH.Nodes.UI"
             mc:Ignorable="d" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid x:Name="mainGrid" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="nameLabel" Content="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0"/>
        <Border x:Name="setupControlBorder" 
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Margin="5,0,5,0">
            <!-- Отступ слева и справа -->
            <!-- Внутри будет setup.Control -->
        </Border>
    </Grid>
</UserControl>
