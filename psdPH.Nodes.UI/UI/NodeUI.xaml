<UserControl x:Class="psdPH.Nodes.UI.NodeUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:psdPH.Nodes.UI"
             mc:Ignorable="d" 
             x:Name="root"
             HorizontalContentAlignment="Stretch"
             MinWidth ="120" ClipToBounds="False"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:psdPH.Nodes.UI">
    <UserControl.Effect>
        <DropShadowEffect Color="#FF4E4950" Opacity="0.2" BlurRadius="15"/>
    </UserControl.Effect>
    <UserControl.Resources>
        <converters:AppearEllipseConverter  
          x:Key="AppearEllipseConverter"/>
        <converters:RightMarginConverter  
  x:Key="RightMarginConverter"/>
    </UserControl.Resources>
    <Border BorderBrush="{Binding MyBrush, ElementName=root}" BorderThickness="2,0,2,2" CornerRadius="3,3,3,3" ClipToBounds="False" x:Name="mainBorder">
        <Border.Background>
            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlLightLightColorKey}}"/>
        </Border.Background>
        <Grid ClipToBounds="False" >
            
            <Grid x:Name="contentGrid">
                <StackPanel ClipToBounds="False">

                    <Grid x:Name="headGrid" Background="{Binding MyBrush, ElementName=root}" 
                      HorizontalAlignment="Stretch" 
                      MinHeight="35"  
                      VerticalAlignment="Stretch" MouseLeftButtonUp="headGrid_MouseLeftButtonUp" >
                        <TextBlock x:Name="headLabel" Text="Label" HorizontalAlignment="Center"  VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF1F1717" TextAlignment="Center"/>
                    </Grid>
                    <UniformGrid x:Name="chainsStack" Columns="1" HorizontalAlignment="Stretch" ClipToBounds="False"/>
                    <Border Background="{Binding MyBrush, ElementName=root}" Height="2" VerticalAlignment="Top"/>
                    <UniformGrid x:Name="inputsStack" Columns="1" HorizontalAlignment="Stretch" ClipToBounds="False"/>
                    <Border Background="{Binding MyBrush, ElementName=root}" Height="2" VerticalAlignment="Top"/>

                    <UniformGrid x:Name="outputsStack" Columns="1" HorizontalAlignment="Stretch" ClipToBounds="False"/>
                </StackPanel>
            </Grid>
            <Ellipse 
x:Name="pickAreaVisEllipse"
Grid.Column="2" 
Fill="#00E01414" 

Margin="{Binding RelativeSource={RelativeSource Self}, Path=Width,Converter={StaticResource RightMarginConverter}}" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Right">

                <Ellipse.Width>
                    <MultiBinding Converter="{StaticResource AppearEllipseConverter}">
                        <Binding ElementName="pickBorder"  
         Path="Width" Mode="OneWay"/>
                        <Binding>
                            <Binding.Source>
                                <sys:Double>3</sys:Double>
                            </Binding.Source>
                        </Binding>
                    </MultiBinding>
                </Ellipse.Width>
                <Ellipse.Height>
                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                </Ellipse.Height>
            </Ellipse>
            <Border x:Name="pickBorder" 
            Width="8" 
            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
            BorderBrush="#FF171717" 
            BorderThickness="1,1,1,1" 
            Grid.Column="2" 
            HorizontalAlignment="Right" 
            VerticalAlignment="Top" 
            Background="#FFEFD166"
            Margin="{Binding RelativeSource={RelativeSource Self}, Path=Width,Converter={StaticResource RightMarginConverter}}" 
            
                    CornerRadius="4,4,4,4" MouseLeftButtonDown="pickBorder_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF9FB16"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=pickAreaVisEllipse}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter Property="Opacity" Value="1"/>
                                </MultiDataTrigger.Setters>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

            </Border>
            <!--<Border Width="8" HorizontalAlignment="Right" VerticalAlignment="Top" Height="8" Margin="0,6,0,0" BorderThickness="1,1,1,1" BorderBrush="Black"/>-->
        </Grid>

    </Border>
</UserControl>
