<UserControl x:Class="psdPH.Nodes.UI.LetBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:psdPH.Nodes.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:LetBarViewModel}">
    <StackPanel Orientation="Horizontal">
        <Label Content="{Binding LetView.Let.Name}"></Label>
        <ContentPresenter Content="{Binding LetView.Control}"/>
    </StackPanel>
</UserControl>
