<UserControl x:Class="psdPH.Nodes.Editor.NodesEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:psdPH.Nodes.Editor"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <ScrollViewer x:Name="canvasViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
            <Border x:Name="canvasBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Background="AliceBlue"/>
        </ScrollViewer>
        <ToolBar Height="36" Background="{x:Null}" VerticalAlignment="Top" >
            <Button Style="{DynamicResource ResourceKey=ObjectNodeButtonStyle}">
                <i:Interaction.Behaviors>
                    <local:LeftClickContextMenuBehavior />
                </i:Interaction.Behaviors>
                
                <Image Source="/psdPH.Nodes.Icons;component/structure.png" />
            </Button>
            <Button Style="{DynamicResource ResourceKey=ObjectNodeButtonStyle}">
                <Image Source="/psdPH.Nodes.Editor;component/inputs.png" />
            </Button>
            <Button Style="{DynamicResource ResourceKey=CalcNodeButtonStyle}">
                <TextBlock FontWeight="Bold" FontSize="14" FontFamily="Arial Unicode MS">=</TextBlock>
            </Button>
            <Button Style="{DynamicResource ResourceKey=CalcNodeButtonStyle}">
                <TextBlock FontSize="12" FontFamily="Arial Unicode MS">...?</TextBlock>
            </Button>
            <Button Style="{DynamicResource ResourceKey=RuleNodeButtonStyle}">
                <Image Source="/psdPH.Nodes.Editor;component/action.png" />
            </Button>
        </ToolBar>
    </Grid>
</UserControl>
