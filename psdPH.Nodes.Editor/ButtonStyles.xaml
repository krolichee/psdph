<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:local="clr-namespace:psdPH.Nodes.Editor">
    
    <!-- Ресурсы цветов -->
        <SolidColorBrush x:Key="BlueButtonBackground" Color="#FF648CAB"/>
        <SolidColorBrush x:Key="BlueButtonBorder" Color="#FF47647B"/>

        <SolidColorBrush x:Key="GreenButtonBackground" Color="#FF64AB6C"/>
        <SolidColorBrush x:Key="GreenButtonBorder" Color="#FF477B5D"/>

        <SolidColorBrush x:Key="GoldButtonBackground" Color="#FFC1AB6E"/>
        <SolidColorBrush x:Key="GoldButtonBorder" Color="#FF928455"/>

        <!-- Базовый стиль для всех кнопок -->
        <Style x:Key="BaseSquareButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Margin" Value="2,0,2,0"/>
    </Style>

        <!-- Стили кнопок с наследованием от базового -->
        <Style x:Key="ObjectNodeButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseSquareButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource BlueButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BlueButtonBorder}"/>
        </Style>

        <Style x:Key="CalcNodeButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseSquareButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource GreenButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GreenButtonBorder}"/>
        </Style>

    <Style x:Key="RuleNodeButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseSquareButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource GoldButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GoldButtonBorder}"/>
    </Style>
</ResourceDictionary>