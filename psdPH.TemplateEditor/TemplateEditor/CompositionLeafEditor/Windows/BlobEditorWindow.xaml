<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:psdPH.TemplateEditor" 
         xmlns:CedStack="clr-namespace:psdPH.CED;assembly=psdPH.CED"  
        x:Class="psdPH.TemplateEditor.BlobEditorWindow" 
         mc:Ignorable="d"
        Title="TemplateEditor"  Width="1920" Height="1080" Closed="Window_Closed" Activated="Window_Activated"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="18"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>

        <Menu x:Name="templateMenu" VerticalAlignment="Center" Height="18" >
            <MenuItem Header="Шаблон" >
                <MenuItem Header="Очистить" Click="clearMenuItem_Click" />
                <MenuItem Header="Сохранить" Click="saveMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Grid x:Name="stacksGrid" Grid.Row="1" Margin="4,4,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="1">
                <local:SectionControl SectionTitle="Структура"
                          BorderThickness="1,1,0,1"
                          IconSource="/psdPH.TemplateEditor;component/TemplateEditor/CompositionLeafEditor/Windows/psdPH Template UI.drawio.png">
                    <CedStack:CEDStackUI x:Name="structureTab"/>
                </local:SectionControl>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1">
                <local:SectionControl Title="Вводы"
                          IconSource="/psdPH.TemplateEditor;component/TemplateEditor/CompositionLeafEditor/Windows/inputs.png">
                    <CedStack:CEDStackUI x:Name="paramTab"/>
                </local:SectionControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
