<UserControl x:Class="psdPH.LetViews.Choose.ChooseLetViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:psdPH.LetViews.Choose"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Label Content="{Binding Caption}"> </Label>
    <ComboBox ItemsSource="{Binding Options}" SelectedValue="{Binding Value}" VerticalAlignment="Center"></ComboBox>
</UserControl>
