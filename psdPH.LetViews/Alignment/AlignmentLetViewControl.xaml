<UserControl x:Class="psdPH.LetViews.AlignmentLetViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:psdPH.LetViews" xmlns:psdph="clr-namespace:psdPH;assembly=psdPH.SpecialControls"
             mc:Ignorable="d" >
    <StackPanel Orientation="Horizontal">
        <Label Content="{Binding Caption}" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"/>
        <psdph:AlignmentControl Dimension="40"/>
    </StackPanel>
</UserControl>
